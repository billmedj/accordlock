{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:accordlock:schema:session-audit-page:6",
  "title": "AccordLock Session Audit Page",
  "description": "A strict page from the durable session audit log.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "session_id",
    "run_id",
    "offset",
    "next_offset",
    "total_events",
    "snapshot_revision",
    "snapshot_at",
    "events",
    "page_digest"
  ],
  "properties": {
    "schema_version": { "const": 6 },
    "task_id": { "$ref": "#/$defs/uuid" },
    "session_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "offset": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "next_offset": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        { "type": "null" }
      ]
    },
    "total_events": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "snapshot_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "snapshot_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    },
    "page_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": { "const": "00000000-0000-0000-0000-000000000000" }
    },
    "intentAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile", "status", "evidence_count", "finding_reasons"],
      "properties": {
        "schema_version": { "const": 1 },
        "profile": { "enum": ["PRE_EXECUTION", "COMPLETE_TRACE"] },
        "status": { "enum": ["VERIFIED", "REVIEW_REQUIRED", "BLOCKED"] },
        "evidence_count": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "finding_reasons": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": {
            "enum": [
              "SUPPORTED",
              "MISSING_EVIDENCE",
              "INCONCLUSIVE_EVIDENCE",
              "UNVERIFIED_PROVENANCE",
              "EXPIRED_CALIBRATION",
              "CONFIDENCE_THRESHOLD_UNCERTAIN",
              "BELOW_THRESHOLD",
              "CONTRADICTORY_EVIDENCE",
              "SCOPE_MISMATCH",
              "EVIDENCE_CHAIN_MISMATCH",
              "LEDGER_SNAPSHOT_MISMATCH",
              "TRUST_POLICY_MISMATCH"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "VERIFIED" } } },
          "then": {
            "properties": {
              "evidence_count": { "minimum": 1 },
              "finding_reasons": {
                "minItems": 1,
                "items": { "const": "SUPPORTED" }
              }
            }
          }
        }
      ]
    },
    "eventBaseProperties": {
      "type": "object",
      "properties": {}
    },
    "event": {
      "oneOf": [
        { "$ref": "#/$defs/sessionApproved" },
        { "$ref": "#/$defs/sessionRevoked" },
        { "$ref": "#/$defs/actionDecision" },
        { "$ref": "#/$defs/actionStarted" },
        { "$ref": "#/$defs/actionCompleted" },
        { "$ref": "#/$defs/actionDenied" },
        { "$ref": "#/$defs/restorePrepared" },
        { "$ref": "#/$defs/restoreCompleted" }
      ]
    },
    "sessionApproved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event_id", "recorded_at", "task_id", "run_id", "workspace_root", "policy_hash", "expires_at"],
      "properties": {
        "type": { "const": "SESSION_APPROVED" },
        "event_id": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "integer", "minimum": 0 },
        "task_id": { "$ref": "#/$defs/uuid" },
        "run_id": { "type": "string", "minLength": 1 },
        "workspace_root": { "type": "string", "minLength": 1 },
        "policy_hash": { "$ref": "#/$defs/digest" },
        "expires_at": { "type": "integer", "minimum": 0 }
      }
    },
    "sessionRevoked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event_id", "recorded_at", "task_id", "run_id", "revocation_digest"],
      "properties": {
        "type": { "const": "SESSION_REVOKED" },
        "event_id": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "integer", "minimum": 0 },
        "task_id": { "$ref": "#/$defs/uuid" },
        "run_id": { "type": "string", "minLength": 1 },
        "revocation_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "actionDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event_id", "recorded_at", "approval_id", "tool_call_id", "proposal_digest", "decision", "evidence_hash", "consumed"],
      "properties": {
        "type": { "const": "ACTION_DECISION" },
        "event_id": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "integer", "minimum": 0 },
        "approval_id": { "$ref": "#/$defs/uuid" },
        "tool_call_id": { "type": "string", "minLength": 1 },
        "proposal_digest": { "$ref": "#/$defs/digest" },
        "decision": { "enum": ["APPROVED", "DENIED"] },
        "evidence_hash": { "$ref": "#/$defs/digest" },
        "consumed": { "type": "boolean" }
      }
    },
    "actionStarted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event_id", "recorded_at", "authorization_id", "tool_call_id", "extension_id", "tool_name", "proposal_digest", "request_hash", "conformance_evaluation_hashes", "task_scope_status", "review_status", "decision_reason_code", "task_control_hash", "task_control_provenance", "intent_evaluation_hash", "intent_assessment"],
      "properties": {
        "type": { "const": "ACTION_STARTED" },
        "event_id": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "integer", "minimum": 0 },
        "authorization_id": { "$ref": "#/$defs/uuid" },
        "tool_call_id": { "type": "string", "minLength": 1 },
        "extension_id": { "type": "string", "minLength": 1 },
        "tool_name": { "type": "string", "minLength": 1 },
        "proposal_digest": { "$ref": "#/$defs/digest" },
        "request_hash": { "$ref": "#/$defs/digest" },
        "conformance_evaluation_hashes": {
          "type": "array",
          "not": { "type": "array", "minItems": 17 },
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "task_scope_status": { "enum": ["WITHIN_APPROVED_ACCESS", "REVIEW_REQUIRED"] },
        "review_status": { "enum": ["NOT_REQUIRED", "APPROVED"] },
        "decision_reason_code": { "enum": ["POLICY_CONFORMANT", "ACTION_APPROVAL_ACCEPTED"] },
        "task_control_hash": { "$ref": "#/$defs/digest" },
        "task_control_provenance": { "const": "DECISION_BOUND" },
        "intent_evaluation_hash": { "$ref": "#/$defs/digest" },
        "intent_assessment": {
          "allOf": [
            { "$ref": "#/$defs/intentAssessment" },
            { "properties": { "profile": { "const": "PRE_EXECUTION" } } }
          ]
        }
      },
      "allOf": [
        {
          "if": { "required": ["task_scope_status"], "properties": { "task_scope_status": { "const": "WITHIN_APPROVED_ACCESS" } } },
          "then": {
            "properties": {
              "review_status": { "const": "NOT_REQUIRED" },
              "decision_reason_code": { "const": "POLICY_CONFORMANT" },
              "conformance_evaluation_hashes": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "required": ["task_scope_status"], "properties": { "task_scope_status": { "const": "REVIEW_REQUIRED" } } },
          "then": {
            "properties": {
              "review_status": { "const": "APPROVED" },
              "decision_reason_code": { "const": "ACTION_APPROVAL_ACCEPTED" },
              "conformance_evaluation_hashes": { "not": { "type": "array", "minItems": 1 } }
            }
          }
        }
      ]
    },
    "actionCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event_id", "recorded_at", "authorization_id", "tool_call_id", "outcome", "state", "record_hash", "execution_lineage_hash", "task_scope_status", "review_status", "decision_reason_code", "task_control_hash", "task_control_provenance", "intent_pre_evaluation_hash", "intent_complete_evaluation_hash", "intent_pre_assessment", "intent_complete_assessment"],
      "properties": {
        "type": { "const": "ACTION_COMPLETED" },
        "event_id": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "integer", "minimum": 0 },
        "authorization_id": { "$ref": "#/$defs/uuid" },
        "tool_call_id": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["SUCCEEDED", "TOOL_REPORTED_ERROR", "TRANSPORT_ERROR"] },
        "state": { "enum": ["SUCCEEDED", "EXECUTION_UNKNOWN"] },
        "record_hash": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "execution_lineage_hash": { "$ref": "#/$defs/digest" },
        "task_scope_status": { "enum": ["WITHIN_APPROVED_ACCESS", "REVIEW_REQUIRED"] },
        "review_status": { "enum": ["NOT_REQUIRED", "APPROVED"] },
        "decision_reason_code": { "enum": ["POLICY_CONFORMANT", "ACTION_APPROVAL_ACCEPTED"] },
        "task_control_hash": { "$ref": "#/$defs/digest" },
        "task_control_provenance": { "enum": ["LINEAGE_BOUND", "EMBEDDED", "RECONSTRUCTED"] },
        "intent_pre_evaluation_hash": { "$ref": "#/$defs/digest" },
        "intent_complete_evaluation_hash": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "intent_pre_assessment": {
          "allOf": [
            { "$ref": "#/$defs/intentAssessment" },
            { "properties": { "profile": { "const": "PRE_EXECUTION" } } }
          ]
        },
        "intent_complete_assessment": {
          "allOf": [
            { "$ref": "#/$defs/intentAssessment" },
            { "properties": { "profile": { "const": "COMPLETE_TRACE" } } }
          ]
        }
      }
    },
    "actionDenied": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event_id", "recorded_at", "denial_id", "attempted_run_id", "tool_call_id", "proposal_digest", "reason_code"],
      "properties": {
        "type": { "const": "ACTION_DENIED" },
        "event_id": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "integer", "minimum": 0 },
        "denial_id": { "type": "integer", "minimum": 0 },
        "attempted_run_id": { "type": "string", "minLength": 1 },
        "tool_call_id": { "type": "string", "minLength": 1 },
        "proposal_digest": { "$ref": "#/$defs/digest" },
        "reason_code": { "type": "string", "minLength": 1 }
      }
    },
    "restorePrepared": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event_id", "recorded_at", "restore_id", "recovery_id", "relative_path", "content_hash"],
      "properties": {
        "type": { "const": "RESTORE_PREPARED" },
        "event_id": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "integer", "minimum": 0 },
        "restore_id": { "$ref": "#/$defs/uuid" },
        "recovery_id": { "$ref": "#/$defs/uuid" },
        "relative_path": { "type": "string", "minLength": 1 },
        "content_hash": { "$ref": "#/$defs/digest" }
      }
    },
    "restoreCompleted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "event_id", "recorded_at", "restore_id", "recovery_id", "relative_path", "record_hash"],
      "properties": {
        "type": { "const": "RESTORE_COMPLETED" },
        "event_id": { "type": "string", "minLength": 1 },
        "recorded_at": { "type": "integer", "minimum": 0 },
        "restore_id": { "$ref": "#/$defs/uuid" },
        "recovery_id": { "$ref": "#/$defs/uuid" },
        "relative_path": { "type": "string", "minLength": 1 },
        "record_hash": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
