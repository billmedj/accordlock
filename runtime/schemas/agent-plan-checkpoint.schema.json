{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:accordlock:schema:agent-plan-checkpoint:1",
  "title": "AccordLock Agent Plan Checkpoint",
  "description": "The exact visible assistant text and ordered tool requests captured before one proposed tool call is authorized.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "run_id",
    "tool_call_id",
    "material",
    "material_sha256",
    "recorded_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "session_id": { "$ref": "#/$defs/sessionId" },
    "run_id": { "$ref": "#/$defs/runId" },
    "tool_call_id": { "$ref": "#/$defs/toolCallId" },
    "material": { "$ref": "#/$defs/material" },
    "material_sha256": { "$ref": "#/$defs/digest" },
    "recorded_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "canonicalText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "sessionId": {
      "allOf": [
        { "$ref": "#/$defs/canonicalText" },
        { "maxLength": 256, "$comment": "The runtime enforces 256 UTF-8 bytes." }
      ]
    },
    "runId": {
      "allOf": [
        { "$ref": "#/$defs/canonicalText" },
        { "maxLength": 256, "$comment": "The runtime enforces 256 UTF-8 bytes." }
      ]
    },
    "toolCallId": {
      "allOf": [
        { "$ref": "#/$defs/canonicalText" },
        { "maxLength": 512, "$comment": "The runtime enforces 512 UTF-8 bytes." }
      ]
    },
    "toolName": {
      "allOf": [
        { "$ref": "#/$defs/canonicalText" },
        { "maxLength": 256, "$comment": "The runtime enforces 256 UTF-8 bytes." }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "toolRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "arguments_sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/toolCallId" },
        "name": { "$ref": "#/$defs/toolName" },
        "arguments_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "tool_requests"],
      "properties": {
        "text": {
          "type": "array",
          "maxItems": 1024,
          "items": { "type": "string" }
        },
        "tool_requests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/toolRequest" }
        }
      },
      "$comment": "Canonical JSON for material is limited to 524288 UTF-8 bytes. Tool request IDs must be unique. Joint proposal validation requires exactly one request matching tool_call_id, its resolved tool name, and its arguments digest."
    }
  }
}
