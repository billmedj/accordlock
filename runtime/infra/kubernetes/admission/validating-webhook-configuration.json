{
  "apiVersion": "admissionregistration.k8s.io/v1",
  "kind": "ValidatingWebhookConfiguration",
  "metadata": {
    "name": "accordlock-webhook",
    "labels": {
      "app.kubernetes.io/name": "accordlock-webhook",
      "app.kubernetes.io/part-of": "accordlock"
    }
  },
  "webhooks": [
    {
      "name": "deployments.accordlock.io",
      "admissionReviewVersions": [
        "v1"
      ],
      "clientConfig": {
        "service": {
          "namespace": "accordlock-system",
          "name": "accordlock-webhook",
          "path": "/validate",
          "port": 443
        },
        "caBundle": ""
      },
      "failurePolicy": "Fail",
      "matchPolicy": "Equivalent",
      "namespaceSelector": {
        "matchLabels": {
          "accordlock.io/enabled": "true"
        }
      },
      "objectSelector": {
        "matchLabels": {
          "accordlock.io/protected": "true"
        }
      },
      "rules": [
        {
          "operations": [
            "UPDATE"
          ],
          "apiGroups": [
            "apps"
          ],
          "apiVersions": [
            "v1"
          ],
          "resources": [
            "deployments"
          ],
          "scope": "Namespaced"
        }
      ],
      "sideEffects": "NoneOnDryRun",
      "timeoutSeconds": 2
    }
  ]
}
