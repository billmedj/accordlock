{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://accordlock.invalid/schemas/eks-activation-bundle-v1.json",
  "title": "AccordLock offline EKS activation evidence bundle v1",
  "description": "Structural interchange schema only. infra/kubernetes/activation/validate.py is the normative fail-closed payload and cryptographic-binding validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "generated_at",
    "activation_context",
    "activation_context_commitment",
    "workload_zones",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "capture_id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "activation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant",
        "environment",
        "cluster_identity",
        "release_digest",
        "route_commitment"
      ],
      "properties": {
        "tenant": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "cluster_identity": {
          "type": "string",
          "minLength": 1
        },
        "release_digest": {
          "$ref": "#/$defs/commitment"
        },
        "route_commitment": {
          "$ref": "#/$defs/commitment"
        }
      }
    },
    "activation_context_commitment": {
      "$ref": "#/$defs/commitment"
    },
    "workload_zones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "commitment": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonBooleanValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonBooleanValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonBooleanValue"
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "observed_at",
        "source_identity",
        "activation_context_commitment",
        "command_commitment",
        "response_commitment",
        "freshness",
        "claims"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
        },
        "kind": {
          "enum": [
            "server_version",
            "route_profile",
            "token_request",
            "token_review",
            "authenticated_get",
            "management_identities",
            "effective_rbac_graph",
            "subject_access_review",
            "webhook_control_plane_call",
            "workload_probe",
            "vwc_configuration",
            "certificate_chain",
            "deployment_mutator_inventory",
            "admission_uid_consumption",
            "provider_request"
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "source_identity": {
          "type": "string",
          "minLength": 3,
          "maxLength": 512,
          "pattern": "^[^\\s]+$"
        },
        "activation_context_commitment": {
          "$ref": "#/$defs/commitment"
        },
        "command_commitment": {
          "$ref": "#/$defs/commitment"
        },
        "response_commitment": {
          "$ref": "#/$defs/commitment"
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_age_seconds",
            "valid_until"
          ],
          "properties": {
            "max_age_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            },
            "valid_until": {
              "$ref": "#/$defs/timestamp"
            }
          }
        },
        "claims": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/nonBooleanValue"
          }
        }
      }
    }
  }
}
