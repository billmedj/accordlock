* text=auto eol=lf

# The source manifest hashes checkout bytes, so text line endings are part of
# the reproducibility contract and must not vary by platform.
SOURCE_MANIFEST.sha256 text eol=lf

*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf whitespace=-trailing-space
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.sql text eol=lf
*.tla text eol=lf
*.cfg text eol=lf
*.cddl text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.jar binary
