#!/usr/bin/env bash
# Modified by AccordLock contributors; see UPSTREAM.md.

set -euo pipefail

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
SCRIPT_PARENT="${SCRIPT_SOURCE%/*}"
[[ "${SCRIPT_PARENT}" != "${SCRIPT_SOURCE}" ]] || SCRIPT_PARENT="."
SCRIPT_DIR="$(cd -P -- "${SCRIPT_PARENT}" && pwd -P)"
source "${SCRIPT_DIR}/system-tool-wrapper.sh"

accordlock_exec_system_tool jbang "${SCRIPT_DIR}/jbang" "$@"
